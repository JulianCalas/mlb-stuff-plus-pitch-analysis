__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.streamlit/cache/
data/pybaseball_cache/
data/raw/chunks/
data/raw/pull.log
data/raw/pitches_*.parquet
data/processed/plot_sample.parquet
data/*.duckdb
data/*.duckdb.wal
models/*.pkl
models/stuff_models.joblib
.DS_Store
*.egg-info/
.venv/
venv/

# data/app is the committed Streamlit bundle (grades, suggestions, a thin
# pitch cloud). The cache rules above do not match it. These exceptions
# keep a broader data ignore from dropping the bundle later.
!data/app/
!data/app/**
